[Unit]
Description=Reflection app local media server
After=network.target

[Service]
Type=simple
User=wafer
Group=wafer
WorkingDirectory=/home/wafer/reflection-app/server
Environment=PORT=8080
Environment=PUBLIC_BASE_URL=http://187.127.210.203:8080
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /home/wafer/reflection-app/server/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
